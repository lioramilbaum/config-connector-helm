{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
  ],
  customManagers: [
    {
      description: 'KCC version in Chart.yaml (version, appVersion, upstream-bundle annotation); tracks the same docker package as values.yaml so both always land in one PR',
      customType: 'regex',
      managerFilePatterns: [
        '/^chart/config-connector/Chart\\.yaml$/',
      ],
      matchStrings: [
        '(?:version|appVersion):[\\s"]*(?<currentValue>[0-9][0-9.]+)',
        'gs://configconnector-operator/(?<currentValue>\\d+\\.\\d+\\.\\d+)/release-bundle\\.tar\\.gz',
      ],
      depNameTemplate: 'gcr.io/gke-release/cnrm/operator',
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
    {
      description: 'KCC operator image digest in values.yaml (must track Chart.yaml appVersion)',
      customType: 'regex',
      managerFilePatterns: [
        '/^chart/config-connector/values\\.yaml$/',
      ],
      matchStrings: [
        '# renovate: image=(?<depName>\\S+) tag=(?<currentValue>\\d+\\.\\d+\\.\\d+)\\n  digest: "(?<currentDigest>sha256:[a-f0-9]{64})"',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
      autoReplaceStringTemplate: '# renovate: image={{{depName}}} tag={{{newValue}}}\n  digest: "{{{newDigest}}}"',
    },
  ],
  packageRules: [
    {
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
      automergeType: 'pr',
    },
    {
      // gcr.io/gke-release/cnrm/operator has all-digit commit-hash tags (e.g. 1159540)
      // that docker versioning ranks above x.y.z; restrict candidates to x.y.z only.
      matchPackageNames: ['gcr.io/gke-release/cnrm/operator'],
      allowedVersions: '/^\\d+\\.\\d+\\.\\d+$/',
    },
    {
      matchPackageNames: ['gcr.io/gke-release/cnrm/operator'],
      groupName: 'Config Connector',
    },
    {
      matchPackageNames: ['!gcr.io/gke-release/cnrm/operator'],
      groupName: 'Dev tools',
    },
  ],
}
