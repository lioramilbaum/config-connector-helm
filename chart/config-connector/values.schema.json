{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "keep": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "default": ""
        },
        "tag": {
          "type": "string",
          "default": ""
        },
        "digest": {
          "type": "string",
          "default": ""
        },
        "pullPolicy": {
          "type": "string",
          "default": ""
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "default": []
    },
    "resources": {
      "type": "object",
      "default": {}
    },
    "goMemLimit": {
      "type": "string",
      "default": ""
    },
    "nodeSelector": {
      "type": "object",
      "default": {}
    },
    "tolerations": {
      "type": "array",
      "default": []
    },
    "affinity": {
      "type": "object",
      "default": {}
    },
    "topologySpreadConstraints": {
      "type": "array",
      "default": []
    },
    "priorityClassName": {
      "type": "string",
      "default": ""
    },
    "podAnnotations": {
      "type": "object",
      "default": {}
    },
    "podLabels": {
      "type": "object",
      "default": {}
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "type": "object",
          "default": {}
        }
      }
    },
    "commonLabels": {
      "type": "object",
      "default": {}
    }
  }
}
